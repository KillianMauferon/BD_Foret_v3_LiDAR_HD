#-------------------------------------------------------
##### Chemins des données
#-------------------------------------------------------
DOSSIER_LIDAR    <- "../data/input/LiDAR"
DOSSIER_MNT      <- "../data/input/MNT"
DOSSIER_MNH      <- "../data/input/MNH"
FICHIER_BDFORET  <- "../data/input/BD_FORET/data/BDFV3_zone_etude.shp"
DOSSIER_PROCESSED <- "../data/input/vrt"
#-------------------------------------------------------
##### Dossiers de résultats (un par étape)
#-------------------------------------------------------
SORTIE_IMPORT   <- "../data/output/result_enrich/1_verifications"
SORTIE_MNH      <- "../data/output/result_enrich/2_MNH_hauteurs_polygones"
SORTIE_MORAN    <- "../data/output/result_enrich/3_correlation_spatiale"
SORTIE_ARBUSTIVE <- "../data/output/result_enrich/4_lidarforfuel_tous_polygones"
SORTIE_FIGURES  <- "../data/output/result_enrich/5_figures"
SORTIE_BDFV3_FUSION <- "../data/output/result_enrich/6_BDFV3_fusion"
for (d in c(SORTIE_IMPORT, SORTIE_MNH, SORTIE_MORAN,
SORTIE_ARBUSTIVE, SORTIE_FIGURES, SORTIE_BDFV3_FUSION)) {
dir.create(d, showWarnings = FALSE, recursive = TRUE)
}
rm(d)
#-------------------------------------------------------
##### Réglages généraux
#-------------------------------------------------------
# Sol de référence pour la hauteur des points :
#   "MNT_IGN" : MNT LiDAR HD de l'IGN (conseillé en relief)
#   "PACKAGE" : sol reconstruit par lidarforfuel
SOL <- "MNT_IGN"
COUVERTURE_MIN <- 0.95   # part minimale d'un polygone couverte par les dalles (0 à 1)
MODE_TEST      <- TRUE   # TRUE = 3 premiers polygones seulement à l'étape 4
#-------------------------------------------------------
##### Étape 2 : MNH
#-------------------------------------------------------
RES_MNH      <- 1   # résolution du MNH calculé si data/mnh est vide (m)
H_MIN_ARBRES <- 5   # pixels du MNH plus bas ignorés (sol, sous-bois)
#-------------------------------------------------------
##### Étape 3 : corrélation spatiale
#-------------------------------------------------------
TAILLE_PIXELS_MORAN <- 20   # taille des pixels de hauteur moyenne (m)
#-------------------------------------------------------
##### Étapes 4 : lidarforfuel
#-------------------------------------------------------
# Essences : LMA (g/m²) et WD (kg/m³) selon code_essence de la BD Forêt v3.
# Pin sylvestre (code 52) : LMA ≈ 160 (SLA 60-63 cm²/g), WD ≈ 430 (400-460).
# Les essences absentes prennent les valeurs par défaut du package.
ESSENCES <- data.frame(
code_essence = c("52"),
LMA          = c(160),
WD           = c(430)
)
LMA_DEFAUT <- 140   # aussi utilisé pour le sous-étage (< 2 m)
WD_DEFAUT  <- 591
EPAISSEUR   <- 0.5    # épaisseur des couches du profil vertical (m)
SEUIL       <- 0.02   # seuil de densité (kg/m³) pour repérer les strates
BUFFER      <- 50     # marge autour du polygone pour les calculs (m)
BUFFER_TRAJ <- 200    # marge pour reconstruire la trajectoire de l'avion (m)
RESOLUTION  <- 10     # pixels des cartes de la parcelle (m)
SAUVER_NUAGE <- FALSE # écrire le nuage prétraité de la parcelle (.laz lourd) ?
# Strates (m)
H_MIN <- 2   # bas de la strate arbustive
H_MAX <- 7   # haut de la strate arbustive
# Conversion densité -> recouvrement (mêmes valeurs que le package)
G     <- 0.5
OMEGA <- 0.77
dalles <- readLAScatalog(DOSSIER_LIDAR)
st_crs(dalles) <- 2154          # Lambert-93
emprise <- st_union(st_as_sf(dalles))
View(emprise)
View(dalles)
#-------------------------------------------------------
##### MNH LiDAR HD (mosaïque virtuelle des dalles)
#-------------------------------------------------------
mnh_files <- list.files(
DOSSIER_MNH, pattern = "\\.tif$",
full.names = TRUE, recursive = TRUE
)
if (length(mnh_files) == 0) {
stop("Aucune dalle MNH '*.tif' dans './data/mnh'.")
}
vrt_file <- file.path(DOSSIER_PROCESSED, "MNH_mosaic.vrt") #enregistrement comme vrt
mnh <- terra::vrt(mnh_files, filename = vrt_file, overwrite = TRUE)
names(mnh) <- "height"
#-------------------------------------------------------
##### MNT LiDAR HD (mosaïque virtuelle des dalles)
#-------------------------------------------------------
mnt_files <- list.files(
DOSSIER_MNT, pattern = "\\.tif$",
full.names = TRUE, recursive = TRUE
)
if (length(mnh_files) == 0) {
stop("Aucune dalle MNT '*.tif' dans './data/mnt'.")
}
vrt_file <- file.path(DOSSIER_PROCESSED, "MNT_mosaic.vrt") #enregistrement comme vrt
mnt <- terra::vrt(mnt_files, filename = vrt_file, overwrite = TRUE)
names(mnt) <- "height_mnt"
crs(mnh) <- "EPSG:2154"   # Lambert-93
#-------------------------------------------------------
##### BD Forêt v3 : polygones couverts par les dalles
#-------------------------------------------------------
bdforet <- st_read(FICHIER_BDFORET, quiet = TRUE)
bdforet <- st_transform(bdforet, 2154)
bdforet <- st_make_valid(bdforet)
# Le .shp coupe les noms de colonnes à 10 caractères : on remet les noms complets
noms_complets <- c(libelle_tf = "libelle_tff",
libelle_es = "libelle_essence",
code_essen = "code_essence",
densite_co = "densite_couvert_arbore",
hauteur_ve = "hauteur_vegetation_moyenne",
hauteur__1 = "hauteur_vegetation_ecart_type",
libelle_dp = "libelle_dpt")
for (court in names(noms_complets)) {
names(bdforet)[names(bdforet) == court] <- noms_complets[court]
}
# Accents : le .dbf est en Latin-1 -> conversion en UTF-8
for (col in names(bdforet)) {
if (is.character(bdforet[[col]]) && !all(validUTF8(bdforet[[col]]))) {
bdforet[[col]] <- iconv(bdforet[[col]], from = "latin1", to = "UTF-8")
}
}
# Une colonne « fid » gêne l'écriture en GeoPackage : on la renomme
names(bdforet)[names(bdforet) == "fid"] <- "fid_bdforet"
#-------------------------------------------------------
##### Parcelle d'étude 21116
#-------------------------------------------------------
BDFV3_fid_21116 <- bdforet |>
filter(bdforet$fid_bdforet == 19679)
#-------------------------------------------------------
##### Vérification visuelle (enregistrée, pas affichée)
#-------------------------------------------------------
png(file.path(SORTIE_IMPORT, "verification_donnees.png"), width = 1600, height = 1600, res = 200)
plot(st_geometry(st_as_sf(dalles)), border = "grey40",
main = "Dalles (gris), polygones BD Foret (bleu), parcelle 21116 (rouge)")
plot(st_geometry(bdforet), add = TRUE, border = "blue")
plot(st_geometry(BDFV3_fid_21116), add = TRUE, border = "red", lwd = 3)
dev.off()
#-------------------------------------------------------
##### ID pour chaque polygone de la bdfv3
#-------------------------------------------------------
bdforet$ID <- seq_len(nrow(bdforet))
#-------------------------------------------------------
##### Pixels d'arbres seulement (> 5 m) - filtre
#-------------------------------------------------------
mnh_arbres <- ifel(mnh > H_MIN_ARBRES, mnh, NA)
# ------------------------------------------------------------------------------
# Extract individual MNH pixel values for every polygon
# ------------------------------------------------------------------------------
#fonction extract de terra pour extraire les hauteurs du mnt dans chaque polygone de la BDFV3
extract_df <- terra::extract(
mnh_arbres, terra::vect(bdforet),
cells = TRUE, ID = TRUE
)
#'we check if height field is there '
if (!("height" %in% names(extract_df))) {
stop("Expected a 'height' column in the extracted MNH values.")
}
# Statistiques de hauteur sur un polygone de la bdforet; NA si pas de pixels valides.
stats_hauteur <- function(z) {
z <- z[!is.na(z)]
if (length(z) == 0) return(rep(NA_real_, 8))
if (length(z) < 4) return(c(mean(z), NA_real_, quantile(z, c(0.10, 0.25, 0.50, 0.75, 0.90, 0.95))))
else return(c(mean(z), sd(z), quantile(z, c(0.10, 0.25, 0.50, 0.75, 0.90, 0.95))))
}
# Keep one metric row per parcel, even if a polygone has no valid MNH pixels.
polygones_metrics <- do.call(rbind, lapply(seq_len(nrow(bdforet)), function(i) {
c(bdforet_id = i, stats_hauteur(extract_df$height[extract_df$ID == i]))
}))
row.names(polygones_metrics) <- NULL
colnames(polygones_metrics) <- c("bdforet_id", "mean", "sd", "p10", "p25", "p50", "p75", "p90", "p95")
# Join metrics to the original plot attributes, preserving plot order.
polygones_attributes <- sf::st_drop_geometry(bdforet)
polygone_MNH <- merge(polygones_attributes, polygones_metrics, by.x = "ID", by.y = "bdforet_id",
all.x = TRUE, sort = FALSE)
##Comparaison des hauteurs de la BDFV3 et du lidar
polygone_MNH$diff_hauteurs <- (polygone_MNH$mean - polygone_MNH$hauteur_vegetation_moyenne)/polygone_MNH$mean
comparaison_h <- ggplot(sf::st_drop_geometry(polygone_MNH), aes(x = hauteur_vegetation_moyenne, y = mean)) +
geom_point()
comparaison_h
#Arrondir les chiffres à un chiffres après la virgule
polygone_MNH <- polygone_MNH %>%
mutate(across(where(is.numeric), ~ round(.x, 1)))
#jointure à la BDFV3
polygone_MNH <- dplyr::left_join(bdforet,
polygone_MNH|> dplyr::select(fid_bdforet, mean, sd, p10,p25,p50,p75,p90,p95, diff_hauteurs),
by = "fid_bdforet")
#enregistrement
sf::st_write(polygone_MNH, file.path(SORTIE_MNH, "polygone_MNH.gpkg"), delete_dsn = TRUE)
polygones_BDFV3_moran <- bdforet #BDFV3 ou l'on ajoutera la valeur de l'indice de moran
#test de la taille des pixels
mnh_extent <- ext(mnh)
if ((reste <- (mnh_extent[2] - mnh_extent[1]) %% TAILLE_PIXELS_MORAN) != 0 ||
(reste <- (mnh_extent[4] - mnh_extent[3]) %% TAILLE_PIXELS_MORAN) != 0) {
stop("pixel size is not matching")}
# raster contenant pour chaque pixel la valeur moyenne du mnh
hauteur_moyenne <- terra::aggregate(mnh, fact = 2*TAILLE_PIXELS_MORAN, fun = mean)
# enregistrement
rast_file <- file.path(SORTIE_MORAN, "hauteur_moyenne.tif")
terra::writeRaster(hauteur_moyenne, filename = rast_file, overwrite = TRUE)
#fonction sur un polygone de la BDFV3 qui return l'indice de moran calculé sur les pixels contenus dans le polygone
moran_polygone <- function(polygone_f, map_pixel, window) {
# prend les pixels contenus dans le polygone
r <- crop(map_pixel, vect(polygone_f), mask = TRUE)
# trop peu de pixels valides (moins de 10 pixels dans le polygone) ou raster trop petit pour la fenêtre 3x3
if (ncol(r) < 3 || nrow(r) < 3 || sum(!is.na(values(r))) < 10) {
return(NA)
}
tryCatch(
terra::autocor(r, w = window, method = "moran", global = TRUE),
error = function(e) {NA}
)
}
# moran pour chaque polygone de la BDFV3
Moran_foret <- function(polygones_BDFV3_moran, map_pixel) {
# voisinage 3x3 (queen), pixel central exclu
window <- matrix(c(1,1,1,1,0,1,1,1,1), nrow = 3, ncol = 3)
vapply(
seq_len(nrow(polygones_BDFV3_moran)),
function(i) moran_polygone(polygones_BDFV3_moran[i, ], map_pixel, window),
numeric(1)
)
}
polygones_BDFV3_moran$moran <- Moran_foret(polygones_BDFV3_moran, hauteur_moyenne)
summary(polygones_BDFV3_moran$moran)
carte_moran <- ggplot(polygones_BDFV3_moran) +
geom_sf(aes(fill = moran), color = NA) +
scale_fill_gradient2(
low = "#b2182b", mid = "white", high = "#2166ac",
midpoint = 0, limits = c(-1, 1),
na.value = "grey85",
name = "Indice de Moran I"
) +
labs(title = "Autocorrelation spatiale de la hauteur de canopee") +
theme_minimal()
ggsave(plot = carte_moran, file.path(SORTIE_FIGURES, "carte_moran.png"))
sf::st_write(polygones_BDFV3_moran, file.path(SORTIE_MORAN, "polygons_moran.gpkg"), delete_dsn = TRUE)
hauteur_moyenne_21116 <- crop(hauteur_moyenne, vect(BDFV3_fid_21116), snap = "in", mask=T, touches = F)
terra::plot(hauteur_moyenne_21116)
rast_file <- file.path(SORTIE_MORAN, "hauteur_moyenne_21116.tif")
terra::writeRaster(hauteur_moyenne_21116, filename = rast_file, overwrite = TRUE)
profil_vertical <- function(zone) {
# 1. Trajectoire de l'avion (donne l'angle de tir de chaque point)
dalles_traj <- dalles
opt_select(dalles_traj)   <- "xyztrnpc"   # colonnes utiles seulement
opt_progress(dalles_traj) <- FALSE
trajectoire <- get_traj(clip_roi(dalles_traj, st_buffer(zone, BUFFER_TRAJ)))
# 2. Nuage de points autour de la zone : sol (2) et végétation (3, 4, 5)
las <- clip_roi(dalles, st_buffer(zone, BUFFER))
las <- filter_poi(las, Classification %in% c(2, 3, 4, 5))
# 3. Prétraitement lidarforfuel, puis retrait du bruit
las <- fPCpretreatment(las, traj = trajectoire)
las <- filter_poi(las, Classification != LASNOISE)
# 4. Hauteur des points avec le MNT de l'IGN : hauteur = altitude - MNT
las@data$Z <- las$Zref - extract(mnt, cbind(las$X, las$Y))[, 1]
las@data$Z[las$Classification == 2] <- 0           # sol = 0 m
las <- filter_poi(las, !is.na(Z) & Z > -1)
las <- las_update(las)
# 5. Points de la zone seule (sans la marge)
las <- clip_roi(las, zone)
# 6. Profil vertical : densité de végétation (PAD) par couche de EPAISSEUR m
#    (WD = valeur par défaut du package, sans effet sur le taux de couverture)
profil <- fCBDprofile_fuelmetrics(datatype = las, WD = 591, d = EPAISSEUR)[[2]]
if (is.null(profil)) stop("trop peu de points")
profil
}
#-------------------------------------------------------
##### Fonction 2 : taux de couverture de la régénération
#-------------------------------------------------------
# profil : profil déjà calculé par profil_vertical(zone). Si on ne le donne pas,
#          il est calculé ici (cas de l'étape 4 : taux_couverture_rege(zone)).
# renvoie : le taux de couverture de la régénération (%), entre H_MIN_REGE et H_MAX_REGE
taux_couverture_rege <- function(profil) {
# 7. Taux de couverture de la régénération (loi de Beer-Lambert)
couches <- profil$H > H_MIN & profil$H <= H_MAX
pai <- sum(profil$PAD[couches]) * EPAISSEUR       # surface végétale (m²/m²)
round(100 * (1 - exp(-G * OMEGA * pai)))
}
polygones_arbustive <- bdforet #BDFV3 ou l'on ajoutera la valeur pour le couvert de la strate arbustive
if (MODE_TEST) polygones_arbustive <- polygones_arbustive[1:3, ]   # 3 polygones pour tester
polygones_arbustive$taux_couverture_rege_pct <- NA
for (i in 1:nrow(polygones_arbustive)) {
cat("Polygone", i, "/", nrow(polygones_arbustive), "\n")
polygones_arbustive$taux_couverture_rege_pct[i] <- tryCatch(
suppressWarnings(taux_couverture_rege(profil_vertical(st_geometry(polygones_arbustive[i, ])))),
error = function(e) { cat("   -> erreur :", conditionMessage(e), "\n"); NA })
}
st_write(polygones_arbustive, file.path(SORTIE_ARBUSTIVE, "BDFV3_couverture_rege.gpkg"),
delete_dsn = TRUE, quiet = TRUE)
carte_rege <- ggplot(polygones_arbustive) +
geom_sf(aes(fill = taux_couverture_rege_pct), color = NA) +
scale_fill_gradient(
low = "lemonchiffon", high = "darkolivegreen",
limits = c(0,100),
na.value = "grey85",
) +
labs(title = "Couverture de la strate arbustive (%)") +
theme_minimal()
carte_rege
ggsave(plot = carte_rege, file.path(SORTIE_FIGURES, "carte_couverture_rege.png"))
#-------------------------------------------------------
##### Parcelle 21116
#-------------------------------------------------------
profil_21116 <- profil_vertical(BDFV3_fid_21116)
taux_21116 <- taux_couverture_rege(profil_21116)
taux_21116 <- taux_couverture_rege(profil_21116)
cat("Parcelle 21116 : taux de couverture de la régénération =", taux_21116, "%\n")
#-------------------------------------------------------
##### Graphique : profil vertical moyen de la parcelle 21116
#-------------------------------------------------------
png(file.path(SORTIE_FIGURES, "profil_parcelle.png"), width = 1400, height = 1600, res = 200)
plot(profil_21116$PAD, profil_21116$H, type = "l", lwd = 2, col = "darkgreen",
xlab = "Densite de surface vegetale PAD (m2/m3)", ylab = "Hauteur (m)",
main = "Profil vertical moyen - parcelle 21116")
abline(h = c(H_MIN, H_MAX), lty = 2, col = "orange")
legend("topright", legend = paste0("regeneration (", H_MIN, "-", H_MAX, " m)"),
lty = 2, col = "orange", bty = "n")
dev.off()
BDFV3_FUSION <- bdforet |>
left_join(
polygone_MNH |>
st_drop_geometry() |>
select(fid_bdforet, mean, sd, p10, p25, p50, p75, p90, p95, diff_hauteurs),
by = "fid_bdforet")
BDFV3_FUSION <- BDFV3_FUSION |>
left_join(
polygones_BDFV3_moran |>
st_drop_geometry() |>
select(fid_bdforet, moran),
by = "fid_bdforet")
BDFV3_FUSION <- BDFV3_FUSION |>
left_join(
polygones_arbustive |>
st_drop_geometry() |>
select(fid_bdforet, taux_couverture_rege_pct),
by = "fid_bdforet"
)
sf::st_write(BDFV3_FUSION, file.path(SORTIE_BDFV3_FUSION, "BDFV3_SORTIE.gpkg"), delete_dsn = TRUE)
