########################################################
#-------------------------------------------------------
# Lance tout le projet, dans l'ordre.
# Pour ne refaire qu'une étape : lancer les lignes 0_ et 1_ (rapides),
# puis seulement l'étape voulue (2_, 3_, 4_ ou 5_).
# L'étape 2b utilise le MNH chargé à l'étape 2 : lancer 2_ avant 2b_.
# L'étape 4 utilise la fonction définie à l'étape 3 : lancer 3_ avant 4_.
#
# Organisation du projet :
#   _workflow.R               ce fichier
#   code/                     les scripts numérotés
#   data/lidar/               dalles LiDAR HD (.copc.laz)
#   data/mnt/                 dalles MNT LiDAR HD (.tif)
#   data/mnh/                 MNH (modèle de hauteur)
#   data/BDFV3_zone_etude/    BDFV3_zone_etude.shp
#   resultats/                sorties (un sous-dossier par étape)


source("./code/0_library_pck.R", echo = TRUE, encoding = "UTF-8")                  # packages
source("./code/0_parameters.R", echo = TRUE, encoding = "UTF-8")                  # chemins et réglages
source("./code/1_import_data.R", echo = TRUE, encoding = "UTF-8")                 # dalles, BD Forêt, parcelle, MNT
source("./code/2_MNH_Lidar.R", echo = TRUE, encoding = "UTF-8")      # code de Cécilia : hauteurs MNH
source("./code/3_correlation_spatiale_hauteur.R", echo = TRUE, encoding = "UTF-8") # code d'Amedeo : indice de Moran
source("./code/4_lidarforfuel_tous_polygones.R", echo = TRUE, encoding = "UTF-8") # couverture de la régé : tous les polygones
source("./code/5_fusion_des_sorties.R", echo = TRUE, encoding = "UTF-8")                     # carte de la couverture de la régé
